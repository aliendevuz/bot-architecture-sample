# Bot Token - BotFather'dan olinadi
BOT_TOKEN=your_bot_token_here

# Environment (development/production)
NODE_ENV=development

# Webhook settings (production uchun)
WEBHOOK_DOMAIN=
WEBHOOK_PORT=3000

# Database (agar kerak bo'lsa)
DATABASE_URL=

# Admin User IDs (vergul bilan ajratilgan)
ADMIN_IDS=123456789,987654321

# Logging
LOG_LEVEL=info